{
  "schema_version": 2,
  "description": "Baseline settings for PCL semantic MLS + selectable CPU/CUDA SCALA-2 raycasting.",
  "run": {
    "dataset_root": "/data/waymo/surface_reconstruction",
    "caseid": "segment-89454214745557131_3160_000_3180_000_with_camera_labels",
    "rasterizer": "cuda",
    "npz_compression": "stored",
    "pcl_threads": 10,
    "mls_workers": 3,
    "attribute_workers": 1,
    "shm_min_free_gb": 8.0,
    "raycast_sensors": ["front_left", "front_center", "front_right", "rear_left", "rear_center", "rear_right"],
    "sensor_workers": 6,
    "raycast_start_frame": 0,
    "raycast_end_frame": null
  },
  "mls": {
    "pcl_executable": "build_pcl_mls/pcl_mls_reconstruct",
    "config_file": "semantic_static_mls_v1.json",
    "stages": ["background", "static_objects", "dynamic_objects"],
    "tile_size_m": 25.0,
    "tile_halo_m": 0.5,
    "minimum_label_confidence": 0.66,
    "exclude_points_in_tracked_boxes": false,
    "require_no_voxel_downsampling": true,
    "overwrite": true
  },
  "raycast": {
    "shared": {
      "intersection_mode": "tangent_patch",
      "patch_radius_m": 0.08,
      "hit_radius_m": 0.03,
      "minimum_range_m": 0.5,
      "maximum_range_m": 80.0,
      "first_mirror_side": 0,
      "static_tile_cache": 64,
      "property_cache": 64,
      "overwrite": true
    },

    "noise": {
      "output": "both",
      "range_sigma_m": 0.05,
      "azimuth_sigma_deg": 0.1,
      "polar_sigma_deg": 0.6,
      "seed": 12345
    },

    "cpu": {
      "candidate_lookup": "structured",
      "ray_neighbor_count": 0,
      "point_batch_size": 500000,
      "ckdtree_workers": 1
    },

    "cuda": {
      "point_batch_size": 2000000,
      "precision": "float64",
      "gpu_cache_gb_per_gpu": 5.0,
      "devices": ["0", "1", "2"],
      "detailed_stats": false
    }
  },
  "environment": {
    "reconstruct_openblas_threads": 1,
    "reconstruct_mkl_threads": 1,
    "reconstruct_numexpr_threads": 1,
    "raycast_omp_threads": 1,
    "raycast_openblas_threads": 1,
    "raycast_mkl_threads": 1,
    "raycast_numexpr_threads": 1
  }
}
